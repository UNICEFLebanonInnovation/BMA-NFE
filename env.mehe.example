# Copy to .env.mehe on the Linux APP VM. Keep the actual file out of Git.
NFE_IMAGE=bma-nfe:mehe
MEHE_HOST=172.16.2.101
MEHE_BIND_ADDRESS=0.0.0.0
MEHE_HTTPS_PORT=443
DJANGO_ALLOWED_HOSTS=172.16.2.101
DJANGO_CSRF_TRUSTED_ORIGINS=https://172.16.2.101
DJANGO_SECRET_KEY=CHANGE_ME_generate_a_unique_secret_with_at_least_50_characters

MEHE_DB_HOST=192.168.41.30
MEHE_DB_PORT=5432
MEHE_DB_NAME=CHANGE_ME_NFE_DATABASE_NAME
MEHE_DB_USER=CHANGE_ME_NFE_DATABASE_USER
MEHE_DB_PASSWORD=CHANGE_ME_NFE_DATABASE_PASSWORD
# Match the DB server's TLS policy; use verify-full and its CA where available.
MEHE_DB_SSLMODE=require

# CHANGE this placeholder to the APP VM mount of the actual share on 192.168.41.31.
# The VM IP alone is not an SMB share name or NFS export path.
NFE_FILE_SHARE_HOST_PATH=/mnt/nfe-media
MEHE_FILE_SHARE_SERVER=192.168.41.31

# CHANGE to the certificate/key files installed on the APP VM.
# The certificate must cover MEHE_HOST (IP SAN for 172.16.2.101, or use its DNS name).
MEHE_TLS_CERT_FILE=/etc/bma-nfe/tls/fullchain.pem
MEHE_TLS_KEY_FILE=/etc/bma-nfe/tls/privkey.pem

NFE_WEB_WORKERS=2
NFE_WORKER_CONCURRENCY=2
DJANGO_SENTRY_DSN=
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
