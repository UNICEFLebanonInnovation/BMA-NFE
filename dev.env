# Database — required. There is no fallback in config/settings/base.py.
DATABASE_URL=

POSTGRES_PASSWORD=mysecretpass
POSTGRES_USER=postgresuser

DJANGO_ADMIN_URL=
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=compile-dev.herokuapp.com
DJANGO_AWS_ACCESS_KEY_ID=
DJANGO_AWS_SECRET_ACCESS_KEY=
DJANGO_AWS_STORAGE_BUCKET_NAME=
DJANGO_MAILGUN_API_KEY=
DJANGO_MAILGUN_SERVER_NAME=
DJANGO_SERVER_EMAIL=
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_ACCOUNT_ALLOW_REGISTRATION=True
DJANGO_SENTRY_DSN=

# Path to the Firebase service-account JSON used for push notifications.
# The file is not in version control: mount it at deploy time or pull it from a
# secret store. Defaults to utility/firebase-creds.json when unset.
FIREBASE_CREDENTIALS_FILE=

NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=student_registration

OTEL_SERVICE_NAME=bma-dev
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev,service.version=2025.10.27-rc1
